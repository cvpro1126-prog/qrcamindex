export default {
  async fetch(request, env, ctx) {
    // 1. Konfigurasi CORS Headers agar HTML bisa melakukan fetch()
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
      "Access-Control-Max-Age": "86400",
    };

    // 2. Tangani Preflight Request (Sangat penting untuk method POST dengan JSON)
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders
      });
    }

    const url = new URL(request.url);
    const actionGet = url.searchParams.get('action');

    try {
      // 3. Tangani Request GET (Cetak Kartu, Load Tabel Peserta & Laporan)
      if (request.method === "GET") {
        if (actionGet === "getMembers") {
          // TODO: Ambil data dari Google Sheets / D1 Database Anda
          const dummyMembers = [
            { id: "1", bib: "017", nama: "Budi Santoso", email: "budi@mail.com", kategori: "Umum", lp: "L" }
          ];
          return new Response(JSON.stringify(dummyMembers), { 
            headers: { ...corsHeaders, "Content-Type": "application/json" } 
          });
        }
        
        if (actionGet === "getAttendanceData") {
          const dummyLogs = {
            stats: { totalMembers: 1, todayPresent: 0, todayPermission: 0, todaySick: 0 },
            logs: []
          };
          return new Response(JSON.stringify(dummyLogs), { 
            headers: { ...corsHeaders, "Content-Type": "application/json" } 
          });
        }
      }

      // 4. Tangani Request POST (Scan QR Hadir & Input Manual)
      if (request.method === "POST") {
        const body = await request.json();
        
        if (body.action === "recordAttendance") {
          // TODO: Simpan data ke database Anda
          const responseJson = {
            success: true,
            message: "Presensi berhasil dicatat!",
            data: { id: body.qrCode, name: "Data Dummy", role: "Umum", time: new Date().toLocaleTimeString(), status: body.status }
          };
          return new Response(JSON.stringify(responseJson), { 
            headers: { ...corsHeaders, "Content-Type": "application/json" } 
          });
        }

        if (body.action === "addMember") {
          const responseJson = { success: true, message: "Peserta berhasil ditambahkan!" };
          return new Response(JSON.stringify(responseJson), { 
            headers: { ...corsHeaders, "Content-Type": "application/json" } 
          });
        }
      }

      // Jika endpoint tidak ditemukan
      return new Response(JSON.stringify({ error: "Action not found" }), { 
        status: 404, 
        headers: { ...corsHeaders, "Content-Type": "application/json" } 
      });

    } catch (error) {
      // Tangkap error jika terjadi masalah di server
      return new Response(JSON.stringify({ success: false, message: error.message }), { 
        status: 500, 
        headers: { ...corsHeaders, "Content-Type": "application/json" } 
      });
    }
  }
};
